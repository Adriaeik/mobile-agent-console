{
  "name": "mobile-agent-console",
  "version": "0.2.0",
  "private": true,
  "description": "A self-hosted, mobile-first tmux console for terminal-based coding agents over Tailscale.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adriaeik/mobile-agent-console.git"
  },
  "bugs": {
    "url": "https://github.com/Adriaeik/mobile-agent-console/issues"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "ALLOW_LOCAL_AUTH=true AUTH_MODE=local node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/*.js && node --check public/app.js && node --check scripts/validate-config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
